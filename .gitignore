# ============================================================================
# .gitignore la nivel de proiect (acopera ambele aplicatii)
# Fiecare aplicatie are si propriul .gitignore pentru node_modules si dist.
# ============================================================================

# ---------------------------------------------------------------------------
# DOCUMENTATIE SI FISIERE PENTRU ASISTENTI AI
# Raman locale, nu ajung pe GitHub. Depozitul public contine doar cod si
# README-uri minimale.
# ---------------------------------------------------------------------------

# Documentatie generata (Word, PDF, alte formate de birou)
Documentatie-VoltMag.docx
*.docx
*.doc
*.pdf
*.odt
*.rtf
*.pptx
*.xlsx

# Folder de documentatie, daca apare vreodata
docs/
documentatie/

# Claude Code
CLAUDE.md
CLAUDE.local.md
.claude/
.claude.json

# Alti asistenti AI (in caz ca se schimba unealta)
AGENTS.md
.cursorrules
.cursor/
.aider*
.continue/
.github/copilot-instructions.md

# ---------------------------------------------------------------------------
# BAZA DE DATE
# Scripturile se ruleaza manual in Supabase. Tine-le intr-un backup separat:
# nefiind versionate, exista doar pe acest calculator.
# ---------------------------------------------------------------------------
*.sql
sql/

# ---------------------------------------------------------------------------
# SECRETE — nu trebuie sa ajunga niciodata in git
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# DEPENDINTE SI BUILD
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
.vercel

# ---------------------------------------------------------------------------
# LOGURI
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# EDITOR SI SISTEM DE OPERARE
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
~$*
*.tmp
*.suo
*.sw?
